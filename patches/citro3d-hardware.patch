+void C3D_PipelineSetHooks(const C3D_PresentHooks* hooks);
+// Frames ended since C3D_PipelineInit (the `frame` the hooks receive).
+u32 C3D_PipelineFrame(void);
+// Outside a frame: every submitted frame has finished and been presented.
+void C3D_PipelineWaitIdle(void);
