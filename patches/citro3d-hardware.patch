+// mkw-3ds: equal float uniforms, compared as bits like memcmp did.
+static inline bool C3Di_FVecSame(const C3D_FVec* a, const C3D_FVec* b)
+{
+	u32 x[4], y[4];
+	memcpy(x, a, sizeof x);
+	memcpy(y, b, sizeof y);
+	return x[0] == y[0] && x[1] == y[1] && x[2] == y[2] && x[3] == y[3];
+}
