+// mkw-3ds frame pipelining (local patch). With the pipeline enabled, two
+// command buffers and two GX queues alternate: C3D_FrameBegin waits for the
+// frame before the previous one only, so the CPU records frame N+1 while the
+// GPU draws frame N. Everything the GPU reads that the CPU rewrites per frame
+// must then be double-buffered by the application, and the LCD framebuffers
+// need a third buffer per screen (the previous frame's transfer may still be
+// queued when the next frame's destination is chosen): the hooks hand the
+// transfer destinations and the presentation to the application.
+typedef struct
+{
+	// Destination of a linked target's display transfer for `frame`
+	// (C3D_FrameEnd, recording thread); NULL falls back to gfxGetFramebuffer.
+	u32* (* framebuffer)(void* user, u32 frame, gfxScreen_t screen, gfx3dSide_t side);
+	// `frame` has finished drawing (GX completion thread): show its buffers.
+	// Replaces gfxScreenSwapBuffers; top/bottom say which screens it drew.
+	void (* present)(void* user, u32 frame, bool top, bool topStereo, bool bottom);
+	void* user;
+} C3D_PresentHooks;
