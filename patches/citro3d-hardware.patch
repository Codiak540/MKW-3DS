+u32 C3D_UniformsConsume(GPU_SHADER_TYPE type, C3D_UniformUpload* out, u32 capacity)
+{
+	int i;
+	if (C3Di_ShaderFVecData[type].dirty) return C3D_UNIFORMS_UNSUPPORTED;
+	for (i = 0; i < C3D_IVUNIF_COUNT; i ++)
+		if (C3D_IVUnifDirty[type][i]) return C3D_UNIFORMS_UNSUPPORTED;
+	u32* dirty = C3Di_FVUnifDirtyMask[type];
+	u32 n = 0;
+	int word;
+	for (word = 0; word < C3D_FVUNIF_COUNT/32; word ++)
+	{
+		while (dirty[word])
+		{
+			i = word*32 + __builtin_ctz(dirty[word]);
+			int j;
+			for (j = i + 1; j < C3D_FVUNIF_COUNT && ((dirty[j>>5] >> (j&31)) & 1); j ++);
+			if (n < capacity)
+			{
+				out[n].offset = 0;
+				out[n].id = (u16)i;
+				out[n].count = (u16)(j-i);
+			}
+			n ++;
+			int k;
+			for (k = i; k < j; k ++)
+			{
+				dirty[k>>5] &= ~(1u << (k&31));
+				C3Di_FVUnifEverDirty[type][k] = true;
+				C3Di_FVUnifShadow[type][k] = C3D_FVUnif[type][k];
+				C3Di_FVUnifShadowValid[type][k] = true;
+			}
+		}
+	}
+	return n;
+}
