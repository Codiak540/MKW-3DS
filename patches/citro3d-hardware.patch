+
+void C3D_UniformPatchRun(u32* buf, u32 offset, const C3D_FVec* values, u32 count)
+{
+	// GPUCMD_Add: chunks of at most 0x100 parameters; each chunk is
+	// [param0][header][param1..] and a chunk with an even parameter count
+	// (odd extra parameters) ends with one alignment word.
+	const u32* p = (const u32*)values;
+	u32 n = count*4;
+	while (n)
+	{
+		const u32 k = n > 0x100 ? 0x100 : n;
+		buf[offset] = p[0];
+		if (k > 1) memcpy(&buf[offset+2], p+1, (k-1)*4);
+		offset += k+1;
+		if ((k-1)&1) offset ++;
+		p += k;
+		n -= k;
+	}
+}
+
+bool C3D_BoolUnifsConsume(GPU_SHADER_TYPE type, u16* value)
+{
+	if (!C3D_BoolUnifsDirty[type]) return false;
+	*value = C3D_BoolUnifs[type];
+	C3D_BoolUnifsDirty[type] = false;
+	return true;
+}
