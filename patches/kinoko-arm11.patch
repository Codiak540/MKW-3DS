+++ b/source/game/SimHash.cc
@@ -0,0 +1,91 @@
+#include "game/SimHash.hh"
+
+#include "game/field/ObjectDirector.hh"
+#include "game/item/ItemDirector.hh"
+#include "game/kart/KartAction.hh"
+#include "game/kart/KartObject.hh"
+#include "game/kart/KartObjectManager.hh"
+#include "game/kart/KartSuspension.hh"
+#include "game/kart/KartTire.hh"
+#include "game/system/RaceManager.hh"
+
+namespace Kinoko {
+
+namespace {
+
+void hashGroup(Hasher &h, Kart::CollisionGroup *group) {
+    if (!group) {
+        return;
+    }
+    SimHash::hash_Kart_CollisionGroup(h, *group);
+    for (u16 i = 0; i < group->hitboxCount(); ++i) {
+        SimHash::hash_Kart_Hitbox(h, group->hitbox(i));
+    }
+}
+
+} // namespace
+
+u64 SimHash::race(Hasher &h) {
+    if (auto *raceMgr = System::RaceManager::Instance()) {
+        hash_System_RaceManager(h, *raceMgr);
+    }
+    h.field("KartAction::s_powWindowActive", &Kart::KartAction::s_powWindowActive,
+            sizeof(Kart::KartAction::s_powWindowActive));
+    h.field("KartAction::s_powWindow", &Kart::KartAction::s_powWindow,
+            sizeof(Kart::KartAction::s_powWindow));
+
+    auto *karts = Kart::KartObjectManager::Instance();
+    const size_t count = karts ? karts->count() : 0;
+    for (size_t i = 0; i < count; ++i) {
+        Kart::KartObject *object = karts->object(i);
+        const Kart::KartAccessor &p = *object->accessor();
+        u32 idx = static_cast<u32>(i);
+        h.field("kart", &idx, sizeof(idx));
+        hash_Kart_KartBody(h, *p.body);
+        Kart::KartPhysics *physics = p.body->physics();
+        hash_Kart_KartPhysics(h, *physics);
+        hash_Kart_KartDynamics(h, *physics->dynamics());
+        hashGroup(h, physics->hitboxGroup());
+        hash_Kart_KartMove(h, *p.move);
+        if (object->isBike()) {
+            hash_Kart_KartMoveBike(h, *static_cast<const Kart::KartMoveBike *>(p.move));
+        }
+        hash_Kart_KartJump(h, *p.move->jump());
+        hash_Kart_KartHalfPipe(h, *p.move->halfPipe());
+        hash_Kart_KartScale(h, *p.move->kartScale());
+        hash_Kart_KartAction(h, *p.action);
+        hash_Kart_KartCollide(h, *p.collide);
+        hash_Kart_KartState(h, *p.state);
+        hash_Kart_KartSub(h, *p.sub);
+        hash_Render_KartModel(h, *p.model);
+        for (auto *susp : p.suspensions) {
+            hash_Kart_KartSuspensionPhysics(h, *susp->suspPhysics());
+        }
+        for (auto *tire : p.tires) {
+            Kart::WheelPhysics *wheel = tire->wheelPhysics();
+            hash_Kart_WheelPhysics(h, *wheel);
+            hashGroup(h, wheel->hitboxGroup());
+        }
+        if (auto *raceMgr = System::RaceManager::Instance()) {
+            if (const System::KPad *pad = raceMgr->player(i).inputs()) {
+                hash_System_KPad(h, *pad);
+            }
+        }
+    }
+
+    if (auto *items = Item::ItemDirector::Instance()) {
+        for (size_t i = 0; i < count; ++i) {
+            hash_Item_KartItem(h, items->kartItem(i));
+        }
+    }
+
+    if (auto *objects = Field::ObjectDirector::Instance()) {
+        for (auto *obj : objects->objects()) {
+            hash_Field_ObjectBase(h, *obj);
+        }
+    }
+
+    return h.value();
+}
+
+} // namespace Kinoko
