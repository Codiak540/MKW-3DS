+    CollisionGroup *mine = collisionGroup();
+    CollisionGroup *theirs = other->collisionGroup();
+    const f32 reach = mine->boundingRadius() + theirs->boundingRadius() + 200.0f;
+    if ((other->pos() - pos()).squaredLength() > reach * reach) {
