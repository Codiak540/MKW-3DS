+/// @brief RMCU 0x8057a2b0 (PlayerSub10_activateMega): 450 frames of Mega. It cures a Lightning
+/// shrink and a crush, then grows through kinoko_scale_up.
+void KartMove::activateMega() {
+    constexpr s16 MEGA_DURATION = 450; // .data 2df4
+
+    auto &status = KartObjectProxy::status();
+    status.setBit(eStatus::Mega);
+    m_megaTimer = MEGA_DURATION;
+    cueSound(SoundCue::MegaUse);
+
+    if (status.onBit(eStatus::Shocked)) {
+        status.resetBit(eStatus::Shocked);
+        m_shockTimer = 0;
+        m_kartScale->endShrink(0);
+        cueSound(SoundCue::Grow);
+    }
+
+    if (status.onBit(eStatus::Crushed)) {
+        status.resetBit(eStatus::Crushed, eStatus::PressAction);
+        m_kartScale->endCrush();
+        cueSound(SoundCue::PressEnd);
+    }
+
+    m_kartScale->startShrink(1);
+    m_megaEnding = false;
+}
+
+/// @brief RMCU 0x8057a478: ends the Mega early. `immediate` also drops the collision scale.
+void KartMove::endMega(bool immediate) {
+    status().resetBit(eStatus::Mega);
+    m_megaTimer = 0;
+    if (!immediate) {
+        cueSound(SoundCue::MegaEnd);
+    }
+
+    if (!m_megaEnding) {
+        m_kartScale->endShrink(1);
+        m_megaEnding = true;
+    }
+
+    if (immediate) {
+        m_megaScale = 1.0f;
+    }
+}
