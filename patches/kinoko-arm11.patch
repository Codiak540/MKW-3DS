new file mode 100644
index 0000000..1d3c46a
--- /dev/null
+++ b/source/game/kart/KartCalcPhased.cc
@@ -0,0 +1,108 @@
+#include "KartObjectManager.hh"
+
+#include "game/kart/KartAction.hh"
+#include "game/kart/KartCollide.hh"
+#include "game/kart/KartObject.hh"
+
+#include "game/field/ObjectDrivableDirector.hh"
+
+#include "game/system/RaceManager.hh"
+
+namespace Kinoko::Kart {
+
+/// mkw-3ds: the retail step reordered into groups whose members do not read each
+/// other's writes (docs/o3ds-kinoko-arm11.md, section 5), so each group may run in
+/// any order and on either core with bit-identical results:
+///   pass 0 for karts below s, kart s alone, pass 0 for karts above s
+///     (s = timer % count is the kart whose slipstream check reads the others),
+///   pass 1 serial part for every kart in index order (racer, object and item contact),
+///   pass 1 local part for every kart (course collision, suspension, pose),
+///   the POW window.
+/// Drivable course objects refresh their collision matrices lazily on the first
+/// query of a tick (retail order). Before a parallel tick every object whose matrices
+/// are already current is stamped so no query writes it; if a stale moving object is
+/// within reach of a kart, this tick runs the groups serially in index order instead,
+/// which is the reference order for everything the lazy update can influence.
+void KartObjectManager::calcPhased() {
+    for (size_t i = 0; i < m_count; ++i) {
+        KartObject *object = m_objects[i];
+        object->collide()->resetKartCollision();
+        object->collide()->setTangentOff(EGG::Vector3f::zero);
+        object->collide()->setMovement(EGG::Vector3f::zero);
+    }
+
+    m_parallelTick = s_calcMode == CalcMode::Parallel && s_runner;
+    if (m_parallelTick) {
+        if (auto *drivables = Field::ObjectDrivableDirector::Instance()) {
+            if (drivables->hasObjects()) {
+                EGG::Vector3f positions[MAX_KARTS];
+                for (size_t i = 0; i < m_count && i < MAX_KARTS; ++i) {
+                    positions[i] = m_objects[i]->pos();
+                }
+                // A kart moves at most ~120 units per tick, and its queries reach
+                // ~300 units around its position (narrow scope 250, triggers, wheels).
+                m_parallelTick = drivables->prepareParallel(positions, m_count, 600.0f);
+            }
+        }
+    }
+    if (m_parallelTick) {
+        ++s_parallelTicks;
+    } else {
+        ++s_serialTicks;
+    }
+
+    // Pass 0 phase-major: part A for every kart of a group, then part B, so each
+    // part's code stays in the instruction cache across the group's karts. Kart s
+    // (slipstream) still sees every lower kart complete and every higher kart untouched.
+    const u32 count = static_cast<u32>(m_count);
+    const u32 slip = count >= 2 ? System::RaceManager::Instance()->timer() % count : 0;
+    runGroup(Phase::Pass0A, 0, slip);
+    runGroup(Phase::Pass0B, 0, slip);
+    runPhase(Phase::Pass0A, slip);
+    runPhase(Phase::Pass0B, slip);
+    runGroup(Phase::Pass0A, slip + 1, count);
+    runGroup(Phase::Pass0B, slip + 1, count);
+
+    for (size_t i = 0; i < m_count; ++i) {
+        m_objects[i]->calcSerial();
+    }
+
+    runGroup(Phase::Pass1Local, 0, count);
+
+    KartAction::CalcPowWindow();
+}
+
+void KartObjectManager::runPhase(Phase phase, u32 index) {
+    if (index >= m_count) {
+        return;
+    }
+    switch (phase) {
+    case Phase::Pass0A:
+        m_objects[index]->calcSubA();
+        break;
+    case Phase::Pass0B:
+        m_objects[index]->calcSubB();
+        break;
+    default:
+        m_objects[index]->calcLocal();
+        break;
+    }
+}
+
+void KartObjectManager::runGroup(Phase phase, u32 begin, u32 end) {
+    if (begin >= end) {
+        return;
+    }
+    if (m_parallelTick) {
+        s_runner->run(*this, phase, begin, end);
+        return;
+    }
+    for (u32 i = begin; i < end; ++i) {
+        runPhase(phase, i);
+    }
+}
+
+u32 KartObjectManager::s_parallelTicks = 0;
+u32 KartObjectManager::s_serialTicks = 0;
+
+} // namespace Kinoko::Kart
