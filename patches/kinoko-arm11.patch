@@ -0,0 +1,74 @@
+#pragma once
+
+/// mkw-3ds: a hash of the complete simulation state after a tick, field by
+/// field (docs/o3ds-kinoko-arm11.md, section 10). The determinism harness
+/// compares the per-tick hash streams of the reference and restructured
+/// physics paths; with tracing on, it names the first field that differs.
+
+#include <Common.hh>
+
+#include <cstddef>
+#include <cstring>
+#include <vector>
+
+#include "game/SimHashIncludes.inc"
+
+namespace Kinoko {
+
+class Hasher {
+public:
+    struct Entry {
+        const char *label;
+        u64 hash;
+    };
+
+    void field(const char *label, const void *p, size_t n) {
+        u64 f = mix(0x9E3779B97F4A7C15ULL, n);
+        const u8 *b = static_cast<const u8 *>(p);
+        while (n >= 8) {
+            u64 w;
+            std::memcpy(&w, b, 8);
+            f = mix(f, w);
+            b += 8;
+            n -= 8;
+        }
+        if (n) {
+            u64 w = 0;
+            std::memcpy(&w, b, n);
+            f = mix(f, w);
+        }
+        m_h = mix(m_h, f);
+        if (m_trace) {
+            m_trace->push_back({label, f});
+        }
+    }
+
+    [[nodiscard]] u64 value() const {
+        return m_h;
+    }
+
+    void setTrace(std::vector<Entry> *trace) {
+        m_trace = trace;
+    }
+
+private:
+    [[nodiscard]] static constexpr u64 mix(u64 h, u64 w) {
+        h ^= w + 0x9E3779B97F4A7C15ULL + (h << 6) + (h >> 2);
+        h *= 0xFF51AFD7ED558CCDULL;
+        h ^= h >> 33;
+        return h;
+    }
+
+    u64 m_h = 0xCBF29CE484222325ULL;
+    std::vector<Entry> *m_trace = nullptr;
+};
+
+struct SimHash {
+    /// Hashes the whole race: race manager, every kart's subsystems, inputs,
+    /// items and course objects. Call after a tick.
+    static u64 race(Hasher &h);
+
+#include "game/SimHashDecl.inc"
+};
+
+} // namespace Kinoko
