+bool ObjectDrivableDirector::prepareParallel(const EGG::Vector3f *positions, size_t count,
+        f32 reach) {
+    bool parallel = true;
+    for (auto *&obj : m_objects) {
+        if (obj->collisionIsFresh()) {
+            obj->prepareCollision();
+            continue;
+        }
+        const EGG::Vector3f &center = obj->getPosition();
+        const f32 radius = obj->getCollisionRadius() + reach;
+        for (size_t i = 0; i < count; ++i) {
+            const EGG::Vector3f d = positions[i] - center;
+            if (EGG::Mathf::abs(d.x) <= radius && EGG::Mathf::abs(d.z) <= radius) {
+                if (parallel) {
+                    const size_t id = static_cast<size_t>(obj->id());
+                    if (id < STALE_IDS) {
+                        ++s_staleTicks[id];
+                    }
+                }
+                parallel = false;
+                break;
+            }
+        }
+    }
+    return parallel;
+}
+
+std::array<u32, ObjectDrivableDirector::STALE_IDS> ObjectDrivableDirector::s_staleTicks = {};
