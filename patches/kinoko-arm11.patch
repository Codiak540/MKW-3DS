+    if (status.onBit(eStatus::HalfpipeMidair, eStatus::InCannon)) {
+        return false;
+    }
+    m_hitboxGroup->setHitboxScale(move()->totalScale());
+    if (status.onBit(eStatus::SoftWallSuspension)) {
+        m_hitboxGroup->hitbox(0).setLastPos(dynamics()->pos());
+    }
+    collide()->prepareWheelCollision(m_hitboxGroup, center, nextRadius);
+    centerOut = m_hitboxGroup->hitbox(0).worldPos();
