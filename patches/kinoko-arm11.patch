+/// @brief RMCU 0x8057a55c: the Mega timer and the 0.02-up / 0.1-down collision scale, separate
+/// from the CHR0 visual scale. The scale-down animation starts 25 frames before the end.
+void KartMove::calcMega() {
+    auto &status = KartObjectProxy::status();
+
+    if (status.offBit(eStatus::Mega)) {
+        m_megaScale = std::max(1.0f, m_megaScale - 0.1f);
+        return;
+    }
+
+    if (--m_megaTimer < 1) {
+        status.resetBit(eStatus::Mega);
+        m_megaTimer = 0;
+        cueSound(SoundCue::MegaEnd);
+        if (!m_megaEnding) {
+            m_kartScale->endShrink(1);
+            m_megaEnding = true;
+        }
+    } else if (!m_megaEnding && m_megaTimer < 26) {
+        m_megaEnding = true;
+        m_kartScale->endShrink(1);
+    }
+
+    m_megaScale = std::min(param()->stats().megaScale, m_megaScale + 0.02f);
+}
