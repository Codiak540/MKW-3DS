# Generates content_version.hpp: the content stamp, version and the
# "what's new" text, validated like tools/build.py did.
function(mkw_content_version out_file)
  set(_ver_file "${CMAKE_SOURCE_DIR}/tools/release/VERSION")
  set(_news_file "${CMAKE_SOURCE_DIR}/tools/release/WHATS_NEW.txt")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_ver_file}" "${_news_file}")

  file(READ "${_ver_file}" MKW_VERSION)
  string(STRIP "${MKW_VERSION}" MKW_VERSION)

  file(READ "${_news_file}" _raw)
  string(REPLACE "\r\n" "\n" _raw "${_raw}")
  set(_rest "${_raw}")
  set(_count 0)
  set(MKW_WHATS_NEW_C "")
  while(NOT "${_rest}" STREQUAL "")
    string(FIND "${_rest}" "\n" _nl)
    if(_nl EQUAL -1)
      set(_line "${_rest}")
      set(_rest "")
    else()
      string(SUBSTRING "${_rest}" 0 ${_nl} _line)
      math(EXPR _next "${_nl} + 1")
      string(SUBSTRING "${_rest}" ${_next} -1 _rest)
    endif()
    string(REGEX REPLACE "[ \t\r]+$" "" _line "${_line}")
    if(_line STREQUAL "")
      continue()
    endif()
    string(LENGTH "${_line}" _len)
    if(_len GREATER 38 OR _line MATCHES "[^ -~]" OR _line MATCHES "[\"\\\\]")
      message(FATAL_ERROR "WHATS_NEW.txt: at most 16 ASCII lines of 38 characters, no quotes or backslashes (line: ${_line})")
    endif()
    math(EXPR _count "${_count} + 1")
    if(_count GREATER 16)
      message(FATAL_ERROR "WHATS_NEW.txt: at most 16 ASCII lines of 38 characters, no quotes or backslashes")
    endif()
    if(_count GREATER 1)
      string(APPEND MKW_WHATS_NEW_C "\\n")
    endif()
    string(APPEND MKW_WHATS_NEW_C "${_line}")
  endwhile()

  if(NOT MKW_CONTENT)
    # IDE/manual configure: fine for editing and test builds. Release builds go
    # through mkw-build, which always passes the real stamp.
    message(STATUS "MKW_CONTENT not set: using 'dev' (use mkw-build for a build that matches your cooked game files)")
    set(MKW_CONTENT "dev")
  endif()
  if(NOT MKW_CONTENT_WINDOWS_LEGACY)
    set(MKW_CONTENT_WINDOWS_LEGACY "${MKW_CONTENT}")
  endif()
  if(MKW_QUICK_UPDATE)
    set(MKW_QUICK_UPDATE 1)
  else()
    set(MKW_QUICK_UPDATE 0)
  endif()
  # configure_file only rewrites when the text changed, so objects stay up to date.
  configure_file("${CMAKE_SOURCE_DIR}/cmake/content_version.hpp.in" "${out_file}" @ONLY)
endfunction()
